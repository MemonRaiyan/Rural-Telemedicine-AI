# GramCare AI — Environment Configuration
# Copy this file to .env before starting production deployment

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database Configuration (SQLite default for zero-config local run; PostgreSQL for cloud production)
GRAMCARE_DB_PATH=gramcare.db
# DATABASE_URL=postgresql://gramcare_user:password@localhost:5432/gramcare_db

# Security & Authentication
GRAMCARE_JWT_SECRET=replace_with_a_secure_random_64_character_hex_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ABDM / ABHA Sandbox Configuration
# Note: Keep ABDM_ENV=sandbox for academic demonstration. Do NOT use production keys without NHA authorization.
ABDM_ENV=sandbox
ABDM_CLIENT_ID=SBX_GRAMCARE_AI_2026
ABDM_CLIENT_SECRET=sandbox_mock_secret_key
ABDM_BASE_URL=https://dev.abdm.gov.in/gateway/v0.5

# Clinical AI Engine Settings
AI_PROVIDER=local
AI_CONFIDENCE_THRESHOLD=0.85
